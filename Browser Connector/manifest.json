{
  "manifest_version": 3,
  "name": "Memoir Windows Connector",
  "version": "5.0.2",
  "description": "Precise active-tab and audio tracking for the local Memoir Windows app. Made by Mina Vian.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Memoir browser connector"
  },
  "icons": {
    "32": "icon32.png",
    "128": "icon128.png"
  }
}
